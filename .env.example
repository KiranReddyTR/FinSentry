# IBM watsonx.ai Configuration for ScamShield AI
# Copy this file to .env and fill in your credentials.
# These EXPO_PUBLIC_ variables are bundled into the app at build time.

# Get your API key from: https://cloud.ibm.com/iam/apikeys
EXPO_PUBLIC_WATSONX_API_KEY=

# Your watsonx.ai project ID (found in the project settings)
EXPO_PUBLIC_WATSONX_PROJECT_ID=

# Your IBM Cloud region (default: us-south)
# Options: us-south, eu-de, eu-gb, jp-tok, au-syd
EXPO_PUBLIC_WATSONX_REGION=us-south
